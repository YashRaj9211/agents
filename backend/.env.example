# NVIDIA NIM values shown below are an example. Any OpenAI-compatible provider works.
LLM_API_KEY=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
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# A persistent Chrome profile lets you log into a site manually once.
# Keep this directory private: it contains browser cookies/session data.
BROWSER_PROFILE_DIR=storage/browser-profile
MAX_STEPS=40000 
MCP_COMMAND=npx.cmd

# SQLite tracker path
# DB_PATH=storage/db/tracker.sqlite3

