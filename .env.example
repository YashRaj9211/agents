# ==============================================================================
# Environment Configuration (.env)
# ==============================================================================

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agents
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/agents

# Agent Model & API Keys (NVIDIA / Gemini / OpenAI)
ROOT_AGENT=nvidia/nemotron-3-super-120b-a12b
ROOT_AGENT_BASE_URL=https://integrate.api.nvidia.com/v1
ROOT_AGENT_KEY=your_nvidia_or_llm_key_here

BROWSER_AGENT=nvidia/nemotron-3-super-120b-a12b
BROWSER_AGENT_BASE_URL=https://integrate.api.nvidia.com/v1
BROWSER_AGENT_KEY=your_nvidia_or_llm_key_here
BROWSER_MODE=headless

# Firecrawl Web Scraping MCP
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
FIRECRAWL_API_URL=https://api.firecrawl.dev
FIRECRAWL_AGENT=nvidia/nemotron-3-super-120b-a12b
FIRECRAWL_AGENT_KEY=your_nvidia_or_llm_key_here
FIRECRAWL_AGENT_BASE_URL=https://integrate.api.nvidia.com/v1

# Garage S3 Object Storage (Artifacts & Screenshots)
S3_ENDPOINT_URL=http://garage:3900
S3_REGION=garage
AWS_ACCESS_KEY_ID=GK0123456789abcdef01234567
AWS_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
S3_BUCKET=agents-artifacts

# Chroma Vector Database
CHROMA_PORT=8001
CHROMA_SERVER_HOST=chroma
CHROMA_SERVER_HTTP_PORT=8000

# Service Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
